{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@contract/*": ["../contract/*"]
    }
  },
  "include": [".", "../contract"],
  "exclude": ["node_modules", "sessions"]
}
